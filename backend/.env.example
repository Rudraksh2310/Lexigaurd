# ---- Database (your local PostgreSQL) ----
DATABASE_URL=postgresql+psycopg2://postgres:YOUR_PASSWORD@localhost:5432/lexiguard
# Quick test without PostgreSQL:  DATABASE_URL=sqlite:///./lexiguard.db

# ---- AI (Groq) ----
GROQ_API_KEY=your-groq-key-here
USE_LLM=true
LLM_MODEL=llama-3.3-70b-versatile
LLM_FALLBACK_MODEL=llama-3.1-8b-instant

# ---- Voice ----
# edge = Microsoft neural voices (online). browser = the browser's own voice (nothing leaves the machine)
TTS_ENGINE=edge
TTS_VOICE_EN=en-IN-NeerjaNeural
TTS_VOICE_HI=hi-IN-SwaraNeural

# ---- Server ----
MAX_UPLOAD_MB=10
# Set to true when the site is served over HTTPS
COOKIE_SECURE=false
